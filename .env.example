# Copy to .env.local and fill in. .env.local is git-ignored and never committed.
# Only the RFP pre-fill needs these; the rest of the app works without them.

# --- Option A: an internal LLM proxy (e.g. the adesso AI hub) ---
# Base address WITHOUT the trailing /v1 (the library adds /v1/messages itself).
# BID_LLM_BASE_URL=https://adesso-ai-hub.3asabc.de
# BID_LLM_API_KEY=sk-aihub-...

# --- Option B: the Anthropic API directly ---
# Leave BID_LLM_BASE_URL unset and put an Anthropic API key in BID_LLM_API_KEY.
# (ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN and ANTHROPIC_BASE_URL also work, but a value already
#  exported in your terminal would override them; the BID_LLM_* names avoid that.)

# Model used for the pre-fill: an Opus-level model, named as your provider names it.
BID_PREFILL_MODEL=claude-opus-5-5
# "default" enables Anthropic's server-side refusal fallback, "off" disables it.
# Leave unset to get: on for the Anthropic API, off behind a proxy.
# BID_PREFILL_FALLBACKS=
