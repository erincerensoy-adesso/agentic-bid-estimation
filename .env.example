# Copy to .env.local and fill in. .env.local is git-ignored and never committed.
# Only the RFP pre-fill needs these; the rest of the app works without them.

# --- Option A: Anthropic API directly ---
ANTHROPIC_API_KEY=

# --- Option B: an internal LLM proxy (e.g. the adesso AI hub) ---
# Base address WITHOUT the trailing /v1 (the library adds /v1/messages itself).
# ANTHROPIC_BASE_URL=https://your-proxy.example.com
# Use ANTHROPIC_API_KEY above if the proxy takes the key in an x-api-key header,
# or ANTHROPIC_AUTH_TOKEN if it expects "Authorization: Bearer <key>".
# ANTHROPIC_AUTH_TOKEN=

# Model used for the pre-fill: an Opus-level model, named as your provider names it.
BID_PREFILL_MODEL=claude-opus-5-5
# "default" enables Anthropic's server-side refusal fallback, "off" disables it.
# Leave unset to get: on for the Anthropic API, off when ANTHROPIC_BASE_URL is set.
# BID_PREFILL_FALLBACKS=
