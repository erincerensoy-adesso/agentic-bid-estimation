  },
  "roleMapping": [
    { "role": "DevOps", "contains": ["devops"], "wholeWords": [] },
    { "role": "Architect", "contains": ["arch"], "wholeWords": [] },
    { "role": "Dev", "contains": ["dev", "engineer"], "wholeWords": [] },
    { "role": "QA", "contains": ["qa", "quality", "test"], "wholeWords": [] },
    { "role": "RE", "contains": ["analyst", "requirement"], "wholeWords": ["ba"] },
    { "role": "UX-UI", "contains": ["ux", "ui", "design"], "wholeWords": [] },
    { "role": "Delivery Manager", "contains": ["delivery", "manager", "pm"], "wholeWords": [] }
  ],
  "survey": [
    { "id": "Q1", "question": "Number of integration points", "levels": ["None", "1–3", "4–10", "More than 10"] },
    { "id": "Q2", "question": "Integration complexity", "levels": ["No integrations", "Standard, documented APIs", "Mix including asynchronous or legacy interfaces", "Mostly legacy, proprietary or undocumented"] },
    { "id": "Q3", "question": "Regulation", "levels": ["None", "General data protection only (GDPR, KVKK)", "Sector regulation (banking, insurance, health, energy)", "Heavy regulation with audit or certification"] },
    { "id": "Q4", "question": "Mission criticality", "levels": ["Internal tool, downtime tolerated", "Business-important", "Business-critical", "Mission-critical, 24×7"] },
    { "id": "Q5", "question": "Importance of UX", "levels": ["Low, functional UI is enough", "Standard", "High", "A differentiator, with a dedicated design system or user research"] },
    { "id": "Q6", "question": "Greenfield or legacy", "levels": ["Greenfield", "Extension of an existing system", "Modernization of a documented legacy system", "Modernization of an undocumented legacy system"] },
    { "id": "Q7", "question": "Data migration", "levels": ["None", "Simple, one source", "Moderate, several sources or cleansing", "Complex, large volume, reconciliation required"] },
    { "id": "Q8", "question": "Security and data residency", "levels": ["No special constraints", "Standard enterprise security", "Strict: in-country or on-premises models required", "Air-gapped or classified environment"] },
    { "id": "Q9", "question": "Clarity of requirements in the RFP", "levels": ["Detailed and unambiguous", "Mostly clear", "High level", "Vague or contradictory"] },
    { "id": "Q10", "question": "Tech stack familiarity", "levels": ["Mainstream stack", "Mainstream with some niche parts", "Mostly niche", "Proprietary or rare"] },
    { "id": "Q11", "question": "Client dependencies and approval cycles", "levels": ["Few, fast decisions", "Moderate", "Many stakeholders, slow approvals", "Heavy governance, external parties"] },
    { "id": "Q12", "question": "Testing and compliance evidence required", "levels": ["Standard testing", "Extended (performance, security)", "Formal test documentation and sign-offs", "Certified or regulator-witnessed testing"] }
  ],
  "weights": {
